#!/bin/sh
# Conventional Commits, English subject, single-line header.
# Example: docs: record the naming glossary

msg_file=$1
header=$(head -n 1 "$msg_file")

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?: [^ ].{0,98}$'

if ! printf '%s' "$header" | grep -Eq "$pattern"; then
  echo "Commit message must be a Conventional Commit." >&2
  echo "Expected: type(scope): subject" >&2
  echo "Types: feat fix docs style refactor perf test build ci chore revert" >&2
  echo "Got: $header" >&2
  exit 1
fi

if printf '%s' "$header" | grep -Eq '\.$'; then
  echo "Commit subject must not end with a period." >&2
  exit 1
fi

exit 0
